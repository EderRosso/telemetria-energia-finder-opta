# =====================================================================
#  Configurações do servidor — copie este arquivo para ".env" e ajuste.
#  O arquivo .env NÃO deve ser compartilhado nem enviado ao GitHub.
# =====================================================================

# Nome que aparece no site e no aplicativo autenticador (2FA)
NOME_SISTEMA=Telemetria de Energia
PORTA=3000

# ---------------- MQTT ----------------
# Teste: broker público (sem senha). Produção: broker próprio com TLS, ex.:
#   MQTT_URL=mqtts://seu-broker.com.br:8883
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USUARIO=
MQTT_SENHA=
# Precisa ser IGUAL ao PREFIXO do ESP32/OPTA
PREFIXO=meu_projeto_energia_123

# ---------------- Primeiro administrador ----------------
# Criado só na primeira execução. Se ADMIN_SENHA ficar vazio, uma senha
# provisória é gerada e mostrada no terminal. No 1º login você troca a
# senha e cadastra o 2FA (Google/Microsoft Authenticator).
ADMIN_EMAIL=admin@local
ADMIN_SENHA=

# ---------------- Segurança ----------------
# Chave usada para criptografar os segredos do 2FA. Se ficar vazia, é gerada
# automaticamente em dados/chave.secreta (faça backup junto com o banco).
CHAVE_SECRETA=
# Coloque true quando o site estiver publicado em HTTPS
COOKIE_SEGURO=false
# true se o site estiver atrás de proxy/túnel (Cloudflare Tunnel, Nginx)
TRUST_PROXY=false
# Duração do login (horas)
SESSAO_HORAS=12

# ---------------- Dados ----------------
# Grava 1 leitura por medidor a cada N segundos (o tempo real recebe todas)
GRAVAR_A_CADA_S=60
# Medidor sem leitura há mais de N segundos aparece como offline
OFFLINE_APOS_S=120
# Fuso horário em minutos (Brasília = -180): define a virada do dia e do mês
FUSO_MINUTOS=-180
